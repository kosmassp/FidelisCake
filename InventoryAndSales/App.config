<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!--
      Which database this installation runs on: SqlServer (default), PostgreSql or Sqlite.
      Changing it means changing ConnectionString below to match. Nothing else - the providers for
      all three are installed alongside the application and are loaded on demand.
    -->
    <add key="DatabaseProvider" value="Sqlite"/>

    <!-- SQL Server -->
    <!--<add key="ConnectionString" value="Server=localhost\SQLEXPRESS;Database=SalesInventory;User Id=sa;Password=kosmas;"/>-->

    <!-- PostgreSql:
    <add key="ConnectionString" value="Host=localhost;Database=salesinventory;Username=postgres;Password=changeme;"/>
    -->

    <!--
      Sqlite - a single file, so nothing to install and nothing to administer.
      Keep |DataDirectory|: it resolves next to the executable, whereas a bare relative path would
      follow the working directory, which the file dialogs move.
    -->
    <add key="ConnectionString" value="Data Source=|DataDirectory|\SalesInventory.db;Version=3;"/>

    <!--
      Address of the text file that says what the current release is. Read once, to seed the
      UPDATE_MANIFEST_URL setting on a database that does not have it yet; after that the database
      value is what counts, so editing this again changes nothing.

      Leave it out and the application never checks for updates. An ordinary Google Drive sharing
      link works - it is turned into a direct download automatically. The file it points at looks
      like this:

        Version: 1.0.1.4
        Drive:   https://drive.google.com/drive/folders/...
        File:    https://drive.google.com/file/d/FILEID/view
        Notes:   Perbaikan laporan

      Drive is the folder a person opens; File is the release ZIP the application installs by
      itself. Without a File line an update is only announced, never installed.
    -->
    <!--<add key="UpdateManifestUrl" value="https://drive.google.com/file/d/FILEID/view"/>-->

    <!--<add key="PrinterName" value="Foxit Reader PDF Printer" />-->
    <add key="PrinterName" value="Microsoft Print to PDF"/>
    <!--<add key="PrinterName" value="EPSON TM-U220 Receipt" />-->
  </appSettings>

  <startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6"/></startup>
</configuration>
