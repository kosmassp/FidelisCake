<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!--
      Which database this installation runs on: SqlServer (default), PostgreSql or Sqlite.
      Changing it also means changing ConnectionString below, and registering the matching provider
      under <system.data> further down.
    -->
    <add key="DatabaseProvider" value="Sqlite"/>

    <!-- SQL Server -->
    <!--<add key="ConnectionString" value="Server=localhost\SQLEXPRESS;Database=SalesInventory;User Id=sa;Password=kosmas;"/>-->

    <!-- PostgreSql:
    <add key="ConnectionString" value="Host=localhost;Database=salesinventory;Username=postgres;Password=changeme;"/>
    -->

    <!-- Sqlite - a single file, so nothing to install and nothing to administer:
    <add key="ConnectionString" value="Data Source=|DataDirectory|\SalesInventory.db;Version=3;"/>
    -->
    <add key="ConnectionString" value="Data Source=|DataDirectory|\SalesInventory.db;Version=3;"/>

    <!--<add key="PrinterName" value="Foxit Reader PDF Printer" />-->
    <add key="PrinterName" value="Microsoft Print to PDF"/>
    <!--<add key="PrinterName" value="EPSON TM-U220 Receipt" />-->
  </appSettings>

  <!--
    ADO.NET providers. System.Data.SqlClient is registered by the framework itself, so SQL Server
    needs nothing here.

    PostgreSQL and SQLite are not part of the framework. Their assemblies live in Include\ and are
    copied beside the executable by the build; the application still holds no compile-time reference
    to either, so which one is used is decided purely by DatabaseProvider above.

    Both are registered whether or not they are in use - an entry only names an assembly, and nothing
    is loaded until the chosen provider is asked for.
  -->
  <system.data>
    <DbProviderFactories>
      <!-- PostgreSql - Npgsql.dll and its dependencies, shipped from Include\PostgreSql -->
      <remove invariant="Npgsql" />
      <add name="Npgsql Data Provider" invariant="Npgsql"
           description="Data Provider for PostgreSQL"
           type="Npgsql.NpgsqlFactory, Npgsql" />

      <!-- Sqlite - System.Data.SQLite.dll and its native SQLite.Interop.dll, from Include\Sqlite -->
      <remove invariant="System.Data.SQLite" />
      <add name="SQLite Data Provider" invariant="System.Data.SQLite"
           description="Data Provider for SQLite"
           type="System.Data.SQLite.SQLiteFactory, System.Data.SQLite" />
    </DbProviderFactories>
  </system.data>

  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <!--
        Npgsql ships against a set of BCL assemblies whose file versions move faster than the
        assembly versions they were compiled against. Because the application deliberately holds no
        compile-time reference to Npgsql, the build cannot work these redirects out for itself, so
        they are written here. Without them PostgreSQL fails at startup with a FileLoadException
        naming one of the assemblies below.

        Only needed when DatabaseProvider is PostgreSql; harmless otherwise, since a redirect for an
        assembly that is never loaded does nothing.
      -->
      <dependentAssembly>
        <assemblyIdentity name="System.Runtime.CompilerServices.Unsafe" publicKeyToken="b03f5f7f11d50a3a" culture="neutral"/>
        <bindingRedirect oldVersion="0.0.0.0-4.0.4.1" newVersion="4.0.4.1"/>
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Memory" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral"/>
        <bindingRedirect oldVersion="0.0.0.0-4.0.1.1" newVersion="4.0.1.1"/>
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Buffers" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral"/>
        <bindingRedirect oldVersion="0.0.0.0-4.0.3.0" newVersion="4.0.3.0"/>
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Numerics.Vectors" publicKeyToken="b03f5f7f11d50a3a" culture="neutral"/>
        <bindingRedirect oldVersion="0.0.0.0-4.1.4.0" newVersion="4.1.4.0"/>
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Threading.Tasks.Extensions" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral"/>
        <bindingRedirect oldVersion="0.0.0.0-4.2.0.1" newVersion="4.2.0.1"/>
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.ValueTuple" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral"/>
        <bindingRedirect oldVersion="0.0.0.0-4.0.3.0" newVersion="4.0.3.0"/>
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Text.Encodings.Web" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral"/>
        <bindingRedirect oldVersion="0.0.0.0-4.0.4.0" newVersion="4.0.4.0"/>
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Text.Json" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral"/>
        <bindingRedirect oldVersion="0.0.0.0-4.0.0.0" newVersion="4.0.0.0"/>
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.Bcl.AsyncInterfaces" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral"/>
        <bindingRedirect oldVersion="0.0.0.0-1.0.0.0" newVersion="1.0.0.0"/>
      </dependentAssembly>
    </assemblyBinding>
  </runtime>

  <startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6"/></startup>
</configuration>
