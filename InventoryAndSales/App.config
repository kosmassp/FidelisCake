<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!--
      Which database this installation runs on: SqlServer (default), PostgreSql or Sqlite.
      Changing it also means changing ConnectionString below, and registering the matching provider
      under <system.data> further down.
    -->
    <add key="DatabaseProvider" value="SqlServer"/>

    <!-- SQL Server -->
    <add key="ConnectionString" value="Server=localhost\SQLEXPRESS;Database=SalesInventory;User Id=sa;Password=kosmas;"/>

    <!-- PostgreSql:
    <add key="ConnectionString" value="Host=localhost;Database=salesinventory;Username=postgres;Password=changeme;"/>
    -->

    <!-- Sqlite - a single file, so nothing to install and nothing to administer:
    <add key="ConnectionString" value="Data Source=|DataDirectory|\SalesInventory.db;Version=3;"/>
    -->

    <!--<add key="PrinterName" value="Foxit Reader PDF Printer" />-->
    <add key="PrinterName" value="Microsoft Print to PDF"/>
    <!--<add key="PrinterName" value="EPSON TM-U220 Receipt" />-->
  </appSettings>

  <!--
    ADO.NET providers. System.Data.SqlClient is registered by the framework itself, so a SQL Server
    installation needs nothing here.

    PostgreSQL and SQLite are not part of the framework. The application deliberately holds no
    compile-time reference to either, so the shipped binary is identical everywhere; a site that
    wants one of them copies the provider assembly beside the executable and uncomments its entry
    below. Nothing else changes.
  -->
  <system.data>
    <DbProviderFactories>
      <!-- PostgreSql - requires Npgsql.dll beside the executable:
      <remove invariant="Npgsql" />
      <add name="Npgsql Data Provider" invariant="Npgsql"
           description="Data Provider for PostgreSQL"
           type="Npgsql.NpgsqlFactory, Npgsql" />
      -->

      <!-- Sqlite - requires System.Data.SQLite.dll and its native SQLite.Interop.dll:
      <remove invariant="System.Data.SQLite" />
      <add name="SQLite Data Provider" invariant="System.Data.SQLite"
           description="Data Provider for SQLite"
           type="System.Data.SQLite.SQLiteFactory, System.Data.SQLite" />
      -->
    </DbProviderFactories>
  </system.data>

  <startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6"/></startup>
</configuration>
